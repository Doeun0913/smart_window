import serial
import sounddevice as sd
import numpy as np
import struct

# --- 설정 (여기서 조절하세요) ---
COM_PORT = 'COM4'      # <--- 본인 포트 번호 확인! (아까 성공한 그 번호)
BAUD_RATE = 115200
FS = 16000
BLOCK_SIZE = 512

# [튜닝 포인트]
GAIN = 10.0             # 소리 크기 (잡음 심하면 좀 줄이세요)
NOISE_THRESHOLD = 0.06 # [노이즈 게이트] 이 값보다 작은 소리는 아예 무시 (0.01 ~ 0.1 사이 조절)
LPF_ALPHA = 0.06     # [필터 강도] 0.1(부드러움) ~ 1.0(날카로움). 낮을수록 잡음이 줄지만 반응이 느려짐.

# 이전 필터 값 저장용 변수
prev_value = 0.0

try:
    ser = serial.Serial(COM_PORT, BAUD_RATE)
    print(f"✅ 필터 적용 모드 실행! ({COM_PORT})")
except Exception as e:
    print(f"❌ 포트 연결 실패: {e}")
    exit()

def audio_callback(outdata, frames, time, status):
    global prev_value
    if status:
        print(status)
    
    if ser.in_waiting >= frames * 2:
        raw_data = ser.read(frames * 2)
        count = len(raw_data) // 2
        ints = struct.unpack(f'>{count}H', raw_data)
        
        # 1. 정규화 (-1.0 ~ 1.0)
        # 피코 ADC는 0~65535, 중간값은 약 32768
        normalized = []
        for x in ints:
            val = (x - 32768) / 32768.0
            
            # 2. [노이즈 게이트] 너무 작은 소리(잡음)는 0으로 죽이기
            if abs(val) < NOISE_THRESHOLD:
                val = 0.0
            
            # 3. [저주파 통과 필터 (LPF)] 급격한 변화(치이익) 막기
            # 수식: 현재값 = 이전값*0.7 + 새값*0.3
            val = prev_value * (1 - LPF_ALPHA) + val * LPF_ALPHA
            prev_value = val
            
            # 4. 증폭
            normalized.append(val * GAIN)
        
        # 길이 맞추기
        if len(normalized) < frames:
            normalized += [0.0] * (frames - len(normalized))
        else:
            normalized = normalized[:frames]
            
        outdata[:] = np.column_stack((normalized, normalized))
    else:
        outdata.fill(0)

try:
    with sd.OutputStream(channels=2, samplerate=FS, blocksize=BLOCK_SIZE, callback=audio_callback):
        print("🤫 쉿! 잡음 잡는 중... (Ctrl+C로 종료)")
        print("마이크를 톡톡 쳐보세요.")
        while True:
            sd.sleep(1000)

except KeyboardInterrupt:
    print("\n종료")
    ser.close()
except Exception as e:
    print(f"에러: {e}")
    ser.close()
